# Named pages are flat .html files at the project root, so Cloudflare Pages
# serves them at their clean no-slash URL (e.g. /support -> support.html) with
# a 200 and no trailing-slash redirect. No explicit rewrites needed here.

# Play (Expo web SPA, local-only build). Real files under /play/_expo and
# /play/assets are served directly by Pages; any other /play route falls back
# to the SPA shell so client-side routing works on deep links / refresh.
/play  /play/index.html  200
/play/*  /play/index.html  200

# Catch-all: serve index.html for any unmatched paths
/*  /index.html  200
